    {
        "id": "55ae7ac926f2c79e",
        "type": "function",
        "z": "2ee6b81b928156c7",
        "name": "function 2",
        "func": "// Требование: let/const, массив, объект, цикл for, if/else\n\nconst studentName = \"Пужук\"; // Используем const\nlet grades = [4, 5, 3, 5, 4]; // Используем let и массив (Array)\nlet sum = 0;\n\n// Используем цикл for\nfor (let i = 0; i < grades.length; i++) {\n    sum += grades[i];\n}\n\nlet average = sum / grades.length;\nlet status = \"\";\n\n// Используем if/else\nif (average >= 4) {\n    status = \"Молодец, стипендия будет!\";\n} else {\n    status = \"Нужно подтянуть хвосты...\";\n}\n\n// Используем объект (Object)\nconst resultData = {\n    name: studentName,\n    marks: grades,\n    averageScore: average,\n    verdict: status,\n    trigger: msg.payload // то самое слово \"старт\" из inject\n};\n\n// Функция должна возвращать объект с полем payload\nmsg.payload = resultData;\nreturn msg;",
