        "func": "// Проверяем, передал ли пользователь параметр id\nif (msg.payload.id) {\n    msg.statusCode = 200; // Успех\n    msg.payload = {\n        message: \"Товар найден\",\n        itemId: msg.payload.id\n    };\n} else {\n    msg.statusCode = 400; // Ошибка клиента\n    msg.payload = {\n        error: \"Bad Request. Вы не передали параметр ?id=\"\n    };\n}\nreturn msg;",
